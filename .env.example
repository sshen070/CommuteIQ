# Copy to .env and fill in
TOMTOM_API_KEY=your-tomtom-api-key

# Optional: Google key with Routes API and Places API (New) enabled. Adds a
# pessimistic (upper bound) Google estimate in weekday commute windows, and
# setup searches Google instead of TomTom (better for e.g. parking lots).
GOOGLE_CLOUD_API_KEY=your-google-api-key

# Optional sampling windows per direction, shared by TomTom (every day) and
# Google (weekdays, toll-free only): local HH:MM-HH:MM, or off. Defaults shown.
# Each hour of window is 12 slots a day. Free allowances: TomTom 20,000 a month
# (the defaults need at most 13,392 with TOLL=true), Google 5,000 (at most
# 4,968; the collector refuses any past 5,000). The startup log shows both.
WINDOW_HOME_TO_UNI=05:00-14:00
WINDOW_UNI_TO_HOME=12:00-21:00

# Optional: last day of the Google Cloud $300 trial (Billing > Overview in the
# Cloud Console). Through this date Google samples its best-guess estimate both
# toll-free and with tolls, and requests past each month's free 5,000 are paid
# from trial credits, stopping at a $295 budget (config.google_credit_budget).
# The default windows cost up to ~$49 a month; with a baseline week every month
# the trial would come to ~$301, so the budget stops Google on Dec 29. After this
# date, or once the budget is used, Google samples toll-free only within the free
# 5,000. Never set it past the real trial end. Unset = free tier only.
GOOGLE_CREDITS_UNTIL=2026-12-29

# Optional baseline weeks: comma-separated local start dates (YYYY-MM-DD), each
# the first of 7 days sampled around the clock, every day, both directions.
# Outside them, TomTom keeps to the windows every day and Google to weekdays.
# Google: 1,152 requests a day on trial credits (~$81 a week, ~$59 more than a
# normal week); the first week starts on deploy day. TomTom with TOLL=true:
# ~5,040 extra requests a week, so at most one week a month fits its 20,000.
# Google runs them only while trial credits last: the free 5,000 can't hold one.
GOOGLE_BASELINE_WEEKS=2026-10-05,2026-11-02
TOMTOM_BASELINE_WEEKS=2026-09-30,2026-10-05,2026-11-02

# Optional: also a baseline week every month, the 7 days from its first Monday
# (true/false). TomTom with TOLL=true and weekends on: 18,000-18,432 a month.
# Google: only while trial credits last, like the listed weeks.
TOMTOM_BASELINE_MONTHLY=true
GOOGLE_BASELINE_MONTHLY=true

# Optional: through this local date, TomTom skips weekends outside its baseline
# weeks. Frees ~432 requests per weekend day, e.g. to fit an extra baseline week
# into a month. Unset = the windows every day.
TOMTOM_WEEKDAYS_ONLY_UNTIL=

# Optional answers for setup_locations.py. A value set here wins, and setup
# only asks about what's left out. Leave a line commented to be asked instead.

# Places: "lat,lon" is used as-is; an address or place name still shows the
# matches to confirm. Re-run setup after changing these.
HOME_LOCATION=33.64936,-117.84227
HOME_NAME=Home
UNI_LOCATION=University of California Riverside
UNI_NAME=UCR Lot 26

# Also sample the fastest route with toll roads allowed (true/false).
# true = 2 TomTom requests per direction per slot instead of 1.
# Read every time the collector starts, so no need to re-run setup.
TOLL=false

# Optional: minutes between weather readings at points every 5 km along the route
# (Open-Meteo, no key): 5, 10, 15, 20, 30 or 60, or off. Default 15, the data's own
# step; more often re-reads the same 15-minute block. Readings start 5 minutes past the
# hour, away from Open-Meteo's busiest moments, and yesterday is archived at 00:05.
# Each point is one call of the free 10,000 a day, e.g. 16 points: ~1,552 a day at
# 15 min, ~4,624 at 5. The startup log shows the count. Past weather:
# python -m conditions.backfill_weather (see CLAUDE.md)
WEATHER_EVERY_MIN=15

# Optional: minutes between forecast refreshes at the same points (Open-Meteo): 5, 10, 15,
# 20, 30 or 60, or off. Default 60, as the US model runs hourly. Each refresh overwrites the
# stored forecast for today through tomorrow evening and drops past days;
# analysis/reports/commute_stats.py uses it for --date (default today). 16 points hourly:
# ~384 calls a day.
# To fill it without a restart: python -m conditions.forecast
FORECAST_EVERY_MIN=60

# Optional Telegram bot: log real drives by tapping a button when you leave and when you
# arrive, and get tomorrow's leave-by times each evening. Make a bot with @BotFather in
# Telegram and paste its token here; leave it blank to turn the bot off. Then restart the
# collector and send the bot any message: it answers with your chat id for TELEGRAM_CHAT_ID.
# Restart again after setting that. Until it's set, nothing is logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional nightly advice (deploy/commuteiq-advice.timer, analysis/reports/daily_advice.py): first
# class start and last class end per weekday, local HH:MM-HH:MM, entries split by ";", e.g.
# mon,wed 09:00-15:20; tue,thu 11:00-16:50; fri 10:00-11:50. Weekdays left out, and days
# calendar.csv marks without classes, get no message. Read on every run: no restart needed.
CLASS_SCHEDULE=mon-thu 09:00-15:20; fri 10:00-11:50

# Minutes to park and walk to class (default 15), and the driving style the message is for:
# aggressive, defensive (default) or relaxed. python -m validation.real_drives (from
# analysis/) shows which one your logged drives match.
CLASS_BUFFER_MIN=15
DRIVING_STYLE=defensive

# Optional: wait until this local time (24-hour HH:MM) before the first sample,
# so data starts on a clean day. Only applies to an empty database; after a
# restart mid-collection, the collector resumes right away.
START_AT=00:00

# Optional: SQLite file location (defaults to data/commute.db)
DB_PATH=/path/to/commute.db
